  m_Name: Volleyball
  m_EditorClassIdentifier: 
  localizedFields:
  - fieldLabel: actorLeftName
    localizedDataList: []
  - fieldLabel: actorRightName
    localizedDataList: []
  - fieldLabel: _currentLanguage
    localizedDataList: []
  - fieldLabel: Volleyball
    localizedDataList:
    - languageCode: en
      key: Volleyball
    - languageCode: ru
      key: "\u0412\u043E\u043B\u0435\u0439\u0431\u043E\u043B"
  costExp: 30
  iconStory: {fileID: 21300000, guid: 737d5bb600763df439ec9c2f2d6d1f80, type: 3}
  localizator:
    translationJson: {fileID: 4900000, guid: f017cca4ecf27e24e90a648f364a6f6f, type: 3}
    _translator:
      languages:
      - languageCode: en
        messages:
        - key: Hi, I'm glad you called me to the match.
        - key: "Yeah, you sure did! I've been wanting to see \na women's volleyball
            game for a long time. \nLook at the view from our seats!"
        - key: "Oh, yeah! I had no idea it would be so \nexciting! I'm not much of
            a volleyball fan, \nbut this match is really impressive."
        - key: Look at that girl. She's in the blue uniform.
        - key: "You're right, she's really good. \nI wouldn't mind meeting her."
        - key: "Don't even dream about it! \nShe won't even look at you. \nAlthough
            I know she goes to the gym a lot."
        - key: "Well, we'll see. \nMaybe I have a chance."
        - key: I don't think so. But good luck.
      - languageCode: ru
        messages:
        - key: "\u041F\u0440\u0438\u0432\u0435\u0442, \u044F \u0440\u0430\u0434,
            \u0447\u0442\u043E \u0442\u044B \n\u0432\u044B\u0442\u0430\u0449\u0438\u043B
            \u043C\u0435\u043D\u044F \u043D\u0430 \u043C\u0430\u0442\u0447!"
        - key: "\u0414\u0430, \u044D\u0442\u043E \u0442\u043E\u0447\u043D\u043E!
            \u0414\u0430\u0432\u043D\u043E \u043C\u0435\u0447\u0442\u0430\u043B \n\u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
            \u043D\u0430 \u0436\u0435\u043D\u0441\u043A\u0438\u0439 \u0432\u043E\u043B\u0435\u0439\u0431\u043E\u043B.
            \n\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438 \u043A\u0430\u043A\u043E\u0439
            \u0432\u0438\u0434 \n\u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
            \u0441 \u043D\u0430\u0448\u0438\u0445 \u043C\u0435\u0441\u0442!"
        - key: "\u041E, \u0434\u0430! \u0414\u0430\u0436\u0435 \u043D\u0435 \u0434\u0443\u043C\u0430\u043B,
            \u0447\u0442\u043E \u0431\u0443\u0434\u0435\u0442 \n\u0442\u0430\u043A
            \u0443\u0432\u043B\u0435\u043A\u0430\u0442\u0435\u043B\u044C\u043D\u043E!
            \u042F \u0432\u043E\u043E\u0431\u0449\u0435 \u043D\u0435 \u043E\u0447\u0435\u043D\u044C
            \n\u043B\u044E\u0431\u043B\u044E \u0432\u043E\u043B\u0435\u0439\u0431\u043E\u043B,
            \u043D\u043E \u044D\u0442\u043E\u0442 \u043C\u0430\u0442\u0447 \n\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
            \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u0435\u0442."
        - key: "\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438
            \u043D\u0430 \u0442\u0443 \u0434\u0435\u0432\u0443\u0448\u043A\u0443.
            \n\u041E\u043D\u0430 \u0432 \u0441\u0438\u043D\u0435\u0439 \u0444\u043E\u0440\u043C\u0435."
        - key: "\u0422\u044B \u043F\u0440\u0430\u0432, \u043E\u043D\u0430 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E
            \u0445\u043E\u0440\u043E\u0448\u0430. \n\u042F \u0431\u044B\u043B \u0431\u044B
            \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432 \u0441 \u043D\u0435\u0439
            \u043F\u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F."
        - key: "\u0414\u0430\u0436\u0435 \u043D\u0435 \u043C\u0435\u0447\u0442\u0430\u0439!
            \u041E\u043D\u0430 \u043D\u0430 \u0442\u0435\u0431\u044F \n\u0434\u0430\u0436\u0435
            \u043D\u0435 \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442.
            \u0425\u043E\u0442\u044F \u044F \u0437\u043D\u0430\u044E, \n\u0447\u0442\u043E
            \u043E\u043D\u0430 \u0447\u0430\u0441\u0442\u043E \u0445\u043E\u0434\u0438\u0442
            \u0432 \u0442\u0440\u0435\u043D\u0430\u0436\u0451\u0440\u043D\u044B\u0439
            \u0437\u0430\u043B."
        - key: "\u041D\u0443, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u043C.
            \n\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0443 \u043C\u0435\u043D\u044F
            \u0435\u0441\u0442\u044C \u0448\u0430\u043D\u0441."
        - key: "\u041D\u0435 \u0434\u0443\u043C\u0430\u044E. \u041D\u043E \u0443\u0434\u0430\u0447\u0438
            \u0442\u0435\u0431\u0435."
      - languageCode: de
        messages:
        - key: "Hallo, ich bin froh, dass du \nmich zu dem Spiel gerufen hast."
        - key: "Ja, da bin ich mir sicher! \nIch wollte schon lange mal \nFrauenvolleyball
            sehen. Schau \ndir die Aussicht von unseren Pl\xE4tzen an!"
        - key: "Oh, ja! Ich hatte keine Ahnung, \ndass es so aufregend sein w\xFCrde!
            \nIch bin kein gro\xDFer Volleyballfan, \naber dieses Spiel ist \nwirklich
            beeindruckend."
        - key: "Seht euch das M\xE4dchen an. \nSie hat das blaue Trikot an."
        - key: "Du hast Recht, sie ist wirklich gut. \nIch w\xFCrde sie gerne kennenlernen."
        - key: "Denk nicht mal im Traum daran! \nSie wird dich nicht einmal ansehen.
            Obwohl \nich wei\xDF, dass sie oft ins Fitnessstudio geht."
        - key: "Nun, wir werden sehen. \nVielleicht habe ich eine Chance."
        - key: "Nein, das glaube ich nicht. \nAber viel Gl\xFCck."
      - languageCode: fr
        messages:
        - key: "Bonjour, je suis content que vous \nm'ayez appel\xE9 pour le match."
        - key: "Oui, j'en suis s\xFBr ! Cela fait longtemps que \nje veux regarder
            le volley-ball f\xE9minin. \nRegardez la vue depuis nos si\xE8ges !"
        - key: "Oh, oui ! Je n'avais aucune id\xE9e que \nce serait si excitant !
            Je ne suis pas une \ngrande fan de volley-ball, mais ce \nmatch est vraiment
            impressionnant."
        - key: "Regarde cette fille. \nElle porte l'uniforme bleu."
        - key: "Tu as raison, elle est vraiment bonne. \nJ'aimerais bien la rencontrer."
        - key: "N'y pense m\xEAme pas ! Elle ne te \nregardera m\xEAme pas. Mais
            je sais \nqu'elle va souvent \xE0 la gym."
        - key: "Eh bien, nous verrons. \nJ'ai peut-\xEAtre une chance."
        - key: Je ne crois pas. Mais bonne chance.
      - languageCode: it
        messages:
        - key: "Ciao, sono felice che tu mi \nabbia chiamato per l'incontro."
        - key: "S\xEC, ne sono certo! Era da molto \ntempo che volevo vedere la pallavolo
            \nfemminile. Guarda la vista dai nostri posti!"
        - key: "Oh, s\xEC! Non avevo idea che \nsarebbe stato cos\xEC emozionante!
            \nNon sono un grande appassionato \ndi pallavolo, ma questa partita \n\xE8
            davvero impressionante."
        - key: "Guardate quella ragazza. \nIndossa l'uniforme blu."
        - key: "Hai ragione, \xE8 davvero brava. \nNon mi dispiacerebbe incontrarla."
        - key: "Non sognarlo nemmeno! Non ti \nguarder\xE0 nemmeno. Anche se \nso
            che va spesso in palestra."
        - key: "Beh, vedremo. Forse ho una possibilit\xE0."
        - key: Non credo. Ma buona fortuna.
      - languageCode: sp
        messages:
        - key: "Hola, me alegro de que me \nhayas llamado para el partido."
        - key: "\xA1S\xED, seguro que s\xED! Llevo mucho \ntiempo queriendo ver voleibol
            femenino. \n\xA1Mira la vista desde nuestros asientos!"
        - key: "\xA1Oh, s\xED! \xA1No ten\xEDa ni idea de \nque ser\xEDa tan emocionante!
            No \nsoy muy aficionado al voleibol, \npero este partido es \nrealmente
            impresionante."
        - key: "Miren a esa chica. \nLleva el uniforme azul."
        - key: "Tienes raz\xF3n, es muy buena. \nNo me importar\xEDa conocerla."
        - key: "\xA1Ni lo sue\xF1es! Ni siquiera te mirar\xE1. \nAunque s\xE9 que
            va mucho al gimnasio."
        - key: "Bueno, ya veremos. Tal vez \ntenga una oportunidad."
        - key: No lo creo. Pero buena suerte.
