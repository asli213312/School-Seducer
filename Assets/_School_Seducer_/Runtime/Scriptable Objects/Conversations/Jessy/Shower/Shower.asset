    _localizedData:
    - languageCode: en
      key: "I should get going. \nDo you know where the shower is? \nFollow me. I'll
        show you where everything is."
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u041C\u043D\u0435 \u0443\u0436\u0435 \u043F\u043E\u0440\u0430 \u0438\u0434\u0442\u0438.
        \n\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0432\u043C\u0435\u0441\u0442\u0435
