  m_Script: {fileID: 11500000, guid: d94a57f9fcad471a9c6ddd88cf10d64e, type: 3}
  m_Name: Shower
  m_EditorClassIdentifier: 
  localizedFields:
  - fieldLabel: actorLeftName
    localizedDataList: []
  - fieldLabel: actorRightName
    localizedDataList: []
  - fieldLabel: _currentLanguage
    localizedDataList: []
  - fieldLabel: Shower
    localizedDataList:
    - languageCode: en
      key: Shower
    - languageCode: ru
      key: "\u0414\u0443\u0448\u0435\u0432\u0430\u044F"
  costExp: 30
  iconStory: {fileID: 21300000, guid: 737d5bb600763df439ec9c2f2d6d1f80, type: 3}
  localizator:
    translationJson: {fileID: 4900000, guid: 8b8b137bd45e5fb40bbbf234733122c3, type: 3}
    _translator:
      languages:
      - languageCode: en
        messages:
        - key: "Maybe we could work out together. \nI could help you with some exercises
            \nor show you a couple of my favorites."
        - key: Sounds great!
        - key: 1 hour later
        - key: "I should get going. \nDo you know where the shower is? \nFollow me.
            I'll show you where everything is."
        - key: Mm-hmm. Uh, yeah.
        - key: "This is where we have the showers. \nBut there's only one available."
        - key: Come on in, I'll wait.
        - key: "You're so cute when you're shy. \nIf you want, we can take a shower
            together?"
      - languageCode: ru
        messages:
        - key: "\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u043C\u044B
            \u043C\u043E\u0433\u043B\u0438 \u0431\u044B \n\u043F\u043E\u0437\u0430\u043D\u0438\u043C\u0430\u0442\u044C\u0441\u044F
            \u0432\u043C\u0435\u0441\u0442\u0435? \u042F \u043C\u043E\u0433 \n\u0431\u044B
            \u043F\u043E\u043C\u043E\u0447\u044C \u0442\u0435\u0431\u0435 \u0441
            \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u044F\u043C\u0438
            \n\u0438\u043B\u0438 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C
            \u043F\u0430\u0440\u0443 \u0441\u0432\u043E\u0438\u0445 \u043B\u044E\u0431\u0438\u043C\u044B\u0445."
        - key: "\u0417\u0432\u0443\u0447\u0438\u0442 \u043E\u0442\u043B\u0438\u0447\u043D\u043E!"
        - key: "1 \u0447\u0430\u0441 \u0441\u043F\u0443\u0441\u0442\u044F"
        - key: "\u041C\u043D\u0435 \u0443\u0436\u0435 \u043F\u043E\u0440\u0430 \u0438\u0434\u0442\u0438.
            \n\u041C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C, \u0432\u043C\u0435\u0441\u0442\u0435
            \u043F\u043E\u0439\u0434\u0451\u043C \u0432 \u0434\u0443\u0448? \n\u042F
            \u043F\u043E\u043A\u0430\u0436\u0443 \u0442\u0435\u0431\u0435, \u0433\u0434\u0435
            \u0442\u0443\u0442 \u0447\u0442\u043E \u043D\u0430\u0445\u043E\u0434\u0438\u0442\u0441\u044F."
        - key: "\u041C\u043C\u043C\u043C\u2026 \u041D\u0443 \u0434\u0430\u2026"
        - key: "\u0412\u043E\u0442 \u0437\u0434\u0435\u0441\u044C \u0443 \u043D\u0430\u0441
            \u0434\u0443\u0448\u0435\u0432\u044B\u0435. \n\u041D\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430
            \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u0430."
        - key: "\u041F\u0440\u043E\u0445\u043E\u0434\u0438, \u044F \u043F\u043E\u0434\u043E\u0436\u0434\u0443."
        - key: "\u0422\u044B \u0442\u0430\u043A\u043E\u0439 \u043C\u0438\u043B\u044B\u0439,
            \u043A\u043E\u0433\u0434\u0430 \n\u0441\u0442\u0435\u0441\u043D\u044F\u0435\u0448\u044C\u0441\u044F.
            \u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C, \u043C\u043E\u0436\u0435\u043C
            \n\u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0434\u0443\u0448 \u0432\u043C\u0435\u0441\u0442\u0435?"
      - languageCode: de
        messages:
        - key: "Vielleicht k\xF6nnen wir zusammen trainieren. \nIch k\xF6nnte dir
            bei ein paar \xDCbungen helfen \noder dir meine Lieblings\xFCbungen zeigen."
        - key: Das klingt toll.
        - key: "1 Stunde sp\xE4ter"
        - key: "Ich sollte jetzt gehen. \nWei\xDFt du, wo die Dusche ist? Komm mit
            mir. \nIch werde dir zeigen, wo alles ist."
        - key: Mm-hmm. Ja.
        - key: "Hier haben wir die Duschen. \nAber es ist nur eine frei."
        - key: Kommen Sie rein, ich warte.
        - key: "Du bist so s\xFC\xDF, wenn \ndu sch\xFCchtern bist. Wenn du \nwillst,
            k\xF6nnen wir zusammen duschen."
      - languageCode: fr
        messages:
        - key: "On pourrait peut-\xEAtre s'entra\xEEner ensemble. \nJe pourrais t'aider
            avec quelques exercices \nou te montrer quelques-uns de mes pr\xE9f\xE9r\xE9s."
        - key: "\xC7a m'a l'air super!"
        - key: 1 heure plus tard
        - key: "Il faut que j'y aille. \nTu sais o\xF9 se trouve la douche ?Suis-moi.
            \nJe vais te montrer o\xF9 tout se trouve."
        - key: Mm-hmm. Oui.
        - key: "C'est ici que nous avons les douches. \nMais il n'y en a qu'une de
            disponible."
        - key: Entrez, j'attendrai.
        - key: "Tu es si mignon quand tu es timide. Si tu veux, \non peut prendre
            une douche ensemble ?"
      - languageCode: it
        messages:
        - key: "Forse potremmo allenarci insieme. \nPotrei aiutarti con qualche esercizio
            o \nmostrarti un paio dei miei preferiti."
        - key: Mi sembra un'ottima idea!
        - key: 1 ora dopo
        - key: "Dovrei andare. Sai dov'\xE8 la doccia? Mi segua. \nTi faccio vedere
            dov'\xE8 tutto."
        - key: "S\xEC."
        - key: "Qui \xE8 dove ci sono le docce. \nMa ce n'\xE8 solo una disponibile."
        - key: Entra, ti aspetto.
        - key: "Sei cos\xEC carino quando sei timido. \nSe vuoi, possiamo fare la
            doccia insieme?"
      - languageCode: sp
        messages:
        - key: "Tal vez podr\xEDamos hacer ejercicio juntos. \nPodr\xEDa ayudarte
            con algunos ejercicios o \nense\xF1arte un par de mis favoritos."
        - key: Eso suena genial.
        - key: "1 hora despu\xE9s"
        - key: "Deber\xEDa irme. \xBFSabes d\xF3nde est\xE1 la ducha? \nS\xEDgueme.
            Te mostrar\xE9 d\xF3nde est\xE1 todo."
        - key: "S\xED."
        - key: "Aqu\xED es donde tenemos las duchas. \nPero s\xF3lo hay una disponible."
        - key: "Entra, esperar\xE9."
        - key: "Eres tan lindo cuando eres t\xEDmido. \nSi quieres, \xBFpodemos ducharnos
            juntos?"
