    - languageCode: it
      key: {fileID: 8300000, guid: 3999f17304b6c2c4ea8b422e4fffa31e, type: 3}
    - languageCode: fr
      key: {fileID: 8300000, guid: ec1f847b8ef58204e8920518ecfa136d, type: 3}
    _localizedData:
    - languageCode: en
      key: Come on in, I'll wait.
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u041F\u0440\u043E\u0445\u043E\u0434\u0438, \u044F \u043F\u043E\u0434\u043E\u0436\u0434\u0443."
      options:
        font: {fileID: 0}
    - languageCode: de
      key: Kommen Sie rein, ich warte.
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: Entrez, j'attendrai.
      options:
        font: {fileID: 0}
    - languageCode: it
      key: Entra, ti aspetto.
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "Entra, esperar\xE9."
      options:
        font: {fileID: 0}
  - ActorIcon: {fileID: 21300000, guid: d5aff797b862976479822e00dc12b5d4, type: 3}
    Msg: "\u0422\u044B \u0442\u0430\u043A\u043E\u0439 \u043C\u0438\u043B\u044B\u0439,
      \u043A\u043E\u0433\u0434\u0430 \n\u0441\u0442\u0435\u0441\u043D\u044F\u0435\u0448\u044C\u0441\u044F.
      \u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C, \u043C\u043E\u0436\u0435\u043C
      \n\u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0434\u0443\u0448 \u0432\u043C\u0435\u0441\u0442\u0435?"
    optionalData:
      GallerySlot: {fileID: 0}
      Branches: []
      otherActorIcon:
        sender: 0
        icon: {fileID: 0}
    AudioMsg: {fileID: 8300000, guid: 4b020c99ce39ae443969309f491fbb67, type: 3}
    <Sender>k__BackingField: 0
    localizedAudioClips:
    - languageCode: en
      key: {fileID: 8300000, guid: bd99e40b59b486e4b819412c1359464c, type: 3}
    - languageCode: ru
      key: {fileID: 8300000, guid: 4b020c99ce39ae443969309f491fbb67, type: 3}
    - languageCode: de
      key: {fileID: 8300000, guid: 5a80403cad959a747bbddfa4a4e35d74, type: 3}
    - languageCode: sp
      key: {fileID: 8300000, guid: 7f78d28b41d54f548a8a23e05d5ec19c, type: 3}
    - languageCode: it
      key: {fileID: 8300000, guid: e533aac15c220cc4190b21f8aea30ba6, type: 3}
    - languageCode: fr
      key: {fileID: 8300000, guid: 5003398d1e9a08049a7dd4d16bb868d4, type: 3}
    _localizedData:
    - languageCode: en
      key: "You're so cute when you're shy. \nIf you want, we can take a shower together?"
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u0422\u044B \u0442\u0430\u043A\u043E\u0439 \u043C\u0438\u043B\u044B\u0439,
        \u043A\u043E\u0433\u0434\u0430 \n\u0441\u0442\u0435\u0441\u043D\u044F\u0435\u0448\u044C\u0441\u044F.
        \u0415\u0441\u043B\u0438 \u0445\u043E\u0447\u0435\u0448\u044C, \u043C\u043E\u0436\u0435\u043C
        \n\u043F\u0440\u0438\u043D\u044F\u0442\u044C \u0434\u0443\u0448 \u0432\u043C\u0435\u0441\u0442\u0435?"
      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Du bist so s\xFC\xDF, wenn \ndu sch\xFCchtern bist. Wenn du \nwillst,
        k\xF6nnen wir zusammen duschen."
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "Tu es si mignon quand tu es timide. Si tu veux, \non peut prendre une
        douche ensemble ?"
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "Sei cos\xEC carino quando sei timido. \nSe vuoi, possiamo fare la doccia
        insieme?"
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "Eres tan lindo cuando eres t\xEDmido. \nSi quieres, \xBFpodemos ducharnos
        juntos?"
      options:
        font: {fileID: 0}
