    <Sender>k__BackingField: 0
    localizedAudioClips:
    - languageCode: en
      key: {fileID: 8300000, guid: 301a062bc0c8d464a9dde74ebeea94e8, type: 3}
    - languageCode: ru
      key: {fileID: 8300000, guid: 431f3b64883b1454ea23f9a9b3fdf0bb, type: 3}
    - languageCode: de
      key: {fileID: 8300000, guid: 5db5127e5bae8cb4cbc73be9afa00042, type: 3}
    - languageCode: sp
      key: {fileID: 8300000, guid: 3065207dffb7c6d44acf6f57ef5bc869, type: 3}
    - languageCode: it
      key: {fileID: 8300000, guid: b26dac67d3e89ac46beb0826a5177473, type: 3}
    - languageCode: fr
      key: {fileID: 8300000, guid: 7834df39f9d3a77449fcf864941531e2, type: 3}
    _localizedData:
    - languageCode: en
      key: "This is where we have the showers. \nBut there's only one available."
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u0412\u043E\u0442 \u0437\u0434\u0435\u0441\u044C \u0443 \u043D\u0430\u0441
        \u0434\u0443\u0448\u0435\u0432\u044B\u0435. \n\u041D\u043E \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u0430
        \u0442\u043E\u043B\u044C\u043A\u043E \u043E\u0434\u043D\u0430."
      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Hier haben wir die Duschen. \nAber es ist nur eine frei."
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "C'est ici que nous avons les douches. \nMais il n'y en a qu'une de disponible."
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "Qui \xE8 dove ci sono le docce. \nMa ce n'\xE8 solo una disponibile."
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "Aqu\xED es donde tenemos las duchas. \nPero s\xF3lo hay una disponible."
      options:
        font: {fileID: 0}
  - ActorIcon: {fileID: 21300000, guid: fb1c9b1c77bb5074a897a113a148c4c7, type: 3}
    Msg: "\u041F\u0440\u043E\u0445\u043E\u0434\u0438, \u044F \u043F\u043E\u0434\u043E\u0436\u0434\u0443."
