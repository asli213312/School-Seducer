      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Oh, wirklich? Aber bist du sicher, \ndass dir kein Handtuch in die \nQuere
        kommen wird?"
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "Oh, vraiment ? Mais vous\n \xEAtes s\xFBr de ne pas laisser \nune serviette
