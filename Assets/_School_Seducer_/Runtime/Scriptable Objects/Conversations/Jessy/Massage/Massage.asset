      key: {fileID: 8300000, guid: 5fd6de084d336b641a36aadd4246830b, type: 3}
    _localizedData:
    - languageCode: en
      key: "Actually, this is a classic \nmassage parlor. And I take my work \nvery
        seriously, if you're \nimplying anything more."
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u0412\u043E\u043E\u0431\u0449\u0435-\u0442\u043E \u044D\u0442\u043E
        \u0441\u0430\u043B\u043E\u043D \u043A\u043B\u0430\u0441\u0441\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
        \n\u043C\u0430\u0441\u0441\u0430\u0436\u0430. \u0418 \u044F \u043E\u0447\u0435\u043D\u044C
        \u0441\u0435\u0440\u044C\u0435\u0437\u043D\u043E \n\u043E\u0442\u043D\u043E\u0448\u0443\u0441\u044C
        \u043A \u0441\u0432\u043E\u0435\u0439 \u0440\u0430\u0431\u043E\u0442\u0435,
        \u0435\u0441\u043B\u0438 \n\u0442\u044B \u043D\u0430\u043C\u0435\u043A\u0430\u0435\u0448\u044C
        \u043D\u0430 \u0447\u0442\u043E-\u0442\u043E \u0431\u043E\u043B\u044C\u0448\u0435\u0435."
      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Eigentlich ist dies ein klassischer \nMassagesalon. Und ich nehme meinen
        \nJob sehr ernst, falls du \netwas anderes andeuten willst."
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "En fait, c'est un salon \nde massage classique. Et je prends \nmon travail
        tr\xE8s au s\xE9rieux, \nsi vous insinuez quelque chose de plus."
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "In realt\xE0, questo \xE8 un classico \ncentro massaggi. E prendo il
        mio \nlavoro molto seriamente, se \nsta insinuando qualcosa di pi\xF9."
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "En realidad, este es un sal\xF3n \nde masajes cl\xE1sico. Y me tomo mi
        trabajo \nmuy en serio, si insin\xFAas algo m\xE1s."
      options:
        font: {fileID: 0}
