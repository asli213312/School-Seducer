    - languageCode: en
      key: Doggy
  costExp: 30
  iconStory: {fileID: 21300000, guid: 737d5bb600763df439ec9c2f2d6d1f80, type: 3}
  localizator:
    translationJson: {fileID: 4900000, guid: 586e4ff00ba48984d836735ce0922eec, type: 3}
    _translator:
      languages:
      - languageCode: en
        messages:
        - key: "You again? How come we \nalways end up somewhere alone?"
        - key: "Hmmm... I wouldn't say that! \nIt's pretty crowded in there."
        - key: Are you implying something?
        - key: "No, I'm sick of hints. \nGet undressed!"
        - key: "Get on the bench and stop \nasking stupid questions!"
        - key: Oh, yeah, Ben!
        - key: "Does it turn you on that \nwe might get caught?"
        - key: "I think so. I'm all hot and bothered. \nBut what if someone comes
            in?"
      - languageCode: ru
        messages:
        - key: "\u041E\u043F\u044F\u0442\u044C \u0442\u044B? \u041A\u0430\u043A \u0442\u0430\u043A
            \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442\u0441\u044F, \n\u0447\u0442\u043E
            \u043C\u044B \u0432\u0441\u0435 \u0432\u0440\u0435\u043C\u044F \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u043C\u0441\u044F
            \n\u0433\u0434\u0435-\u0442\u043E \u043D\u0430\u0435\u0434\u0438\u043D\u0435?"
        - key: "\u0425\u043C\u043C\u043C\u2026 \u042F \u0431\u044B \u0442\u0430\u043A
            \u043D\u0435 \u0441\u043A\u0430\u0437\u0430\u043B! \n\u0422\u0430\u043C
            \u0432 \u0437\u0430\u043B\u0435 \u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
            \u043C\u043D\u043E\u0433\u043E \u043D\u0430\u0440\u043E\u0434\u0443."
        - key: "\u0422\u044B \u043D\u0430 \u0447\u0442\u043E-\u0442\u043E \u043D\u0430\u043C\u0435\u043A\u0430\u0435\u0448\u044C?"
        - key: "\u041D\u0435\u0442, \u043C\u043D\u0435 \u043D\u0430\u0434\u043E\u0435\u043B\u0438
            \u043D\u0430\u043C\u0435\u043A\u0438. \n\u0420\u0430\u0437\u0434\u0435\u0432\u0430\u0439\u0441\u044F!"
        - key: "\u0412\u0441\u0442\u0430\u043D\u044C \u043D\u0430 \u043B\u0430\u0432\u043A\u0443
            \u0438 \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u0442\u044C \n\u0437\u0430\u0434\u0430\u0432\u0430\u0442\u044C
            \u0434\u0443\u0440\u0430\u0446\u043A\u0438\u0435 \u0432\u043E\u043F\u0440\u043E\u0441\u044B!"
        - key: "\u041E, \u0434\u0430 \u0411\u0435\u043D!"
        - key: "\u0422\u0435\u0431\u044F \u0437\u0430\u0432\u043E\u0434\u0438\u0442,
            \u0447\u0442\u043E \u043D\u0430\u0441 \u043C\u043E\u0433\u0443\u0442
            \u0437\u0430\u0441\u0442\u0443\u043A\u0430\u0442\u044C?"
        - key: "\u0414\u0443\u043C\u0430\u044E \u0434\u0430, \u044F \u0443\u0436\u0435
            \u0432\u0441\u044F \u0442\u0435\u043A\u0443! \n\u041D\u043E \u0432\u0434\u0440\u0443\u0433
            \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u0439\u0434\u0435\u0442?"
      - languageCode: de
        messages:
        - key: "Du schon wieder? Wie kommt es, \ndass wir immer irgendwo alleine
            landen?"
        - key: "Hmmm... Das w\xFCrde ich so \nnicht sagen! Es sind eine \nMenge Leute
            im Publikum."
        - key: Willst du damit etwas andeuten?
        - key: "Nein, ich habe die Nase \nvoll von Andeutungen. \nZiehen Sie sich
            aus!"
        - key: "Setz dich auf die Bank \nund h\xF6r auf, dumme \nFragen zu stellen!"
        - key: Oh, ja, Ben!
        - key: "Macht es dich an, dass \nman uns erwischen k\xF6nnte?"
        - key: "Ich glaube ja, ich bin ganz nass. \nAber was ist, wenn jemand reinkommt?"
      - languageCode: fr
        messages:
        - key: "Encore vous ? Comment se fait-il \nque nous nous retrouvions \ntoujours
            seuls quelque part ?"
        - key: "Hmmm... Je ne dirais pas \xE7a ! \nIl y a beaucoup de monde \ndans
            le public."
        - key: Qu'est-ce que tu insinues ?
        - key: "Non, j'en ai marre des allusions. \nD\xE9shabillez-vous !"
        - key: "Monte sur le banc et arr\xEAte \nde poser des questions stupides
            !"
        - key: Oh, oui, Ben !
        - key: "\xC7a t'excite qu'on puisse \nse faire prendre ?"
        - key: "Je pense que oui, je suis \ntout mouill\xE9. Et si quelqu'un entre
            ?"
      - languageCode: it
        messages:
        - key: "Ancora tu? Come mai finiamo \nsempre in un posto da soli?"
        - key: "Hmmm... Non direi proprio! C'\xE8 un \nsacco di gente tra il pubblico."
        - key: Stai insinuando qualcosa?
        - key: "No, sono stufo di allusioni. \nSpogliati!"
        - key: "Sali in panchina e smettila \ndi fare domande stupide!"
        - key: "Oh, s\xEC, Ben!"
        - key: "Ti eccita l'idea che potremmo \nessere scoperti?"
        - key: "Penso di s\xEC, sono tutta bagnata. \nMa se entra qualcuno?"
      - languageCode: sp
        messages:
        - key: "\xBFT\xFA otra vez? \xBFC\xF3mo es que \nsiempre acabamos solos en
            alg\xFAn sitio?"
        - key: "Hmmm... \xA1Yo no dir\xEDa eso! \nHay mucha gente entre el p\xFAblico."
        - key: "\xBFEst\xE1s insinuando algo?"
        - key: "No, estoy harto de insinuaciones. \n\xA1Desn\xFAdate!"
        - key: "\xA1S\xFAbete al banco y deja de \nhacer preguntas est\xFApidas!"
        - key: "\xA1Oh, s\xED, Ben!"
        - key: "\xBFTe excita que nos puedan pillar?"
        - key: "Creo que s\xED, estoy toda mojada. \n\xBFPero y si entra alguien?"
