  m_Script: {fileID: 11500000, guid: d94a57f9fcad471a9c6ddd88cf10d64e, type: 3}
  m_Name: Doggy
  m_EditorClassIdentifier: 
  localizedFields:
  - fieldLabel: actorLeftName
    localizedDataList: []
  - fieldLabel: actorRightName
    localizedDataList: []
  - fieldLabel: _currentLanguage
