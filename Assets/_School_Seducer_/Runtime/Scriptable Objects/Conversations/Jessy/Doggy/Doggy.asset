  - ActorIcon: {fileID: 21300000, guid: fb1c9b1c77bb5074a897a113a148c4c7, type: 3}
    Msg: "\u0422\u0435\u0431\u044F \u0437\u0430\u0432\u043E\u0434\u0438\u0442, \u0447\u0442\u043E
      \u043D\u0430\u0441 \u043C\u043E\u0433\u0443\u0442 \u0437\u0430\u0441\u0442\u0443\u043A\u0430\u0442\u044C?"
    optionalData:
      GallerySlot: {fileID: 0}
      Branches: []
      otherActorIcon:
        sender: 0
        icon: {fileID: 0}
    AudioMsg: {fileID: 8300000, guid: bf7f50470a8abfe48aefac4e33544dc7, type: 3}
    <Sender>k__BackingField: 1
    localizedAudioClips:
    - languageCode: en
      key: {fileID: 8300000, guid: 6f267c391f6453f448a9c8c26c456d2a, type: 3}
    - languageCode: ru
      key: {fileID: 8300000, guid: bf7f50470a8abfe48aefac4e33544dc7, type: 3}
    - languageCode: de
      key: {fileID: 8300000, guid: f29cbe2b6db37984a8f28fa683dab61c, type: 3}
    - languageCode: sp
      key: {fileID: 8300000, guid: bb67f609e291d37409acc3818681d472, type: 3}
    - languageCode: it
      key: {fileID: 8300000, guid: 32887ad95f21e2e409957f500145d40b, type: 3}
    - languageCode: fr
      key: {fileID: 8300000, guid: 431e7ed861e799f4c8ee1214a7833035, type: 3}
    _localizedData:
    - languageCode: en
      key: "Does it turn you on that \nwe might get caught?"
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u0422\u0435\u0431\u044F \u0437\u0430\u0432\u043E\u0434\u0438\u0442,
        \u0447\u0442\u043E \u043D\u0430\u0441 \u043C\u043E\u0433\u0443\u0442 \u0437\u0430\u0441\u0442\u0443\u043A\u0430\u0442\u044C?"
      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Macht es dich an, dass \nman uns erwischen k\xF6nnte?"
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "\xC7a t'excite qu'on puisse \nse faire prendre ?"
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "Ti eccita l'idea che potremmo \nessere scoperti?"
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "\xBFTe excita que nos puedan pillar?"
      options:
        font: {fileID: 0}
  - ActorIcon: {fileID: 21300000, guid: d5aff797b862976479822e00dc12b5d4, type: 3}
    Msg: "\u0414\u0443\u043C\u0430\u044E \u0434\u0430, \u044F \u0443\u0436\u0435
      \u0432\u0441\u044F \u0442\u0435\u043A\u0443! \n\u041D\u043E \u0432\u0434\u0440\u0443\u0433
      \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u0439\u0434\u0435\u0442?"
    optionalData:
      GallerySlot: {fileID: 0}
      Branches: []
      otherActorIcon:
        sender: 0
        icon: {fileID: 0}
    AudioMsg: {fileID: 8300000, guid: c86de7523371e374fa2ecbb5a5c0e7e6, type: 3}
    <Sender>k__BackingField: 0
    localizedAudioClips:
    - languageCode: en
      key: {fileID: 8300000, guid: f248cef2c28c0d04192e608a4f7ebc8b, type: 3}
    - languageCode: ru
      key: {fileID: 8300000, guid: c86de7523371e374fa2ecbb5a5c0e7e6, type: 3}
    - languageCode: de
      key: {fileID: 8300000, guid: 9466e8b234d18e149adc35cb12c2ff89, type: 3}
    - languageCode: sp
      key: {fileID: 8300000, guid: b88810e6b213d634ca679c529b7a10d4, type: 3}
    - languageCode: it
      key: {fileID: 8300000, guid: b39451544dcb1484898f3a4b359d1603, type: 3}
    - languageCode: fr
      key: {fileID: 8300000, guid: 3c2442ca366141943bf253179b26c0f1, type: 3}
    _localizedData:
    - languageCode: en
      key: "I think so. I'm all hot and bothered. \nBut what if someone comes in?"
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u0414\u0443\u043C\u0430\u044E \u0434\u0430, \u044F \u0443\u0436\u0435
        \u0432\u0441\u044F \u0442\u0435\u043A\u0443! \n\u041D\u043E \u0432\u0434\u0440\u0443\u0433
        \u043A\u0442\u043E-\u0442\u043E \u0437\u0430\u0439\u0434\u0435\u0442?"
      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Ich glaube ja, ich bin ganz nass. \nAber was ist, wenn jemand reinkommt?"
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "Je pense que oui, je suis \ntout mouill\xE9. Et si quelqu'un entre ?"
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "Penso di s\xEC, sono tutta bagnata. \nMa se entra qualcuno?"
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "Creo que s\xED, estoy toda mojada. \n\xBFPero y si entra alguien?"
      options:
        font: {fileID: 0}
