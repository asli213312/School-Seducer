    - languageCode: fr
      key: {fileID: 8300000, guid: 27a065bd6f0384e4dbbbd6e4bf619bda, type: 3}
    _localizedData:
    - languageCode: en
      key: The last workout was impressive!
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u041F\u0440\u043E\u0448\u043B\u0430\u044F \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430
        \n\u0431\u044B\u043B\u0430 \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u044F\u044E\u0449\u0435\u0439!"
      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Das Training von gestern \nAbend war beeindruckend!"
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "La s\xE9ance d'entra\xEEnement d'hier \nsoir \xE9tait impressionnante
        !"
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "L'allenamento di ieri sera \n\xE8 stato impressionante!"
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "El entrenamiento de \nanoche fue impresionante."
      options:
        font: {fileID: 0}
  - ActorIcon: {fileID: 21300000, guid: fb1c9b1c77bb5074a897a113a148c4c7, type: 3}
    Msg: "\u0415\u0441\u043B\u0438 \u0431\u044B \u043A\u0430\u0436\u0434\u0430\u044F
      \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \n\u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u043B\u0430\u0441\u044C
      \u0442\u0430\u043A, \u044F \n\u0431\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F
      \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u0435\u0435."
    optionalData:
      GallerySlot: {fileID: 0}
      Branches: []
      otherActorIcon:
        sender: 0
        icon: {fileID: 0}
    AudioMsg: {fileID: 8300000, guid: 8274ecce090ad0244b687b29e84d0598, type: 3}
    <Sender>k__BackingField: 1
    localizedAudioClips:
    - languageCode: en
      key: {fileID: 8300000, guid: 3621f1075ac75174ab997259afbe9d87, type: 3}
    - languageCode: ru
      key: {fileID: 8300000, guid: 8274ecce090ad0244b687b29e84d0598, type: 3}
    - languageCode: de
      key: {fileID: 8300000, guid: 71948fa8910d93e4cb77371adefd4ceb, type: 3}
    - languageCode: sp
      key: {fileID: 8300000, guid: ca6fcd9c19ab3294394793e7ea08e972, type: 3}
    - languageCode: it
      key: {fileID: 8300000, guid: 783dccf67331f244a938533b3502812b, type: 3}
    - languageCode: fr
      key: {fileID: 8300000, guid: 5d79821a8a4b6194bba77465e06382e3, type: 3}
    _localizedData:
    - languageCode: en
      key: "If every workout ended like that, \nI'd work out more regularly."
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u0415\u0441\u043B\u0438 \u0431\u044B \u043A\u0430\u0436\u0434\u0430\u044F
        \u0442\u0440\u0435\u043D\u0438\u0440\u043E\u0432\u043A\u0430 \n\u0437\u0430\u043A\u0430\u043D\u0447\u0438\u0432\u0430\u043B\u0430\u0441\u044C
        \u0442\u0430\u043A, \u044F \n\u0431\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u043B\u0441\u044F
        \u0440\u0435\u0433\u0443\u043B\u044F\u0440\u043D\u0435\u0435."
      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Wenn jede Trainingseinheit so enden \nw\xFCrde, w\xFCrde ich regelm\xE4\xDFiger
        trainieren."
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "Si toutes les s\xE9ances d'entra\xEEnement \nse terminaient ainsi, je
        m'entra\xEEnerais \nplus r\xE9guli\xE8rement."
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "Se ogni allenamento finisse cos\xEC, \nmi allenerei pi\xF9 regolarmente."
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "Si todos los entrenamientos acabaran as\xED, lo har\xEDa m\xE1s a menudo."
      options:
        font: {fileID: 0}
  - ActorIcon: {fileID: 21300000, guid: d5aff797b862976479822e00dc12b5d4, type: 3}
    Msg: "\u0425\u043E\u0447\u0435\u0448\u044C \u044F \u043F\u043E\u043C\u043E\u0433\u0443
      \u0442\u0435\u0431\u0435 \u0441 \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u0435\u0439?
