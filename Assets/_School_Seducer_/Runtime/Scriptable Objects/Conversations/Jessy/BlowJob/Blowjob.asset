    - languageCode: de
      key: {fileID: 8300000, guid: 8c2fe9e4c53b0fa45a8beeb414287130, type: 3}
    - languageCode: sp
      key: {fileID: 8300000, guid: 76f64fdf0fbb08a47815a181cdffa2b9, type: 3}
    - languageCode: it
      key: {fileID: 8300000, guid: 384f93c81aa6a254fb3a57e5d16390be, type: 3}
    - languageCode: fr
      key: {fileID: 8300000, guid: a6bea6d5e5952b944b213e2d5911d7e7, type: 3}
    _localizedData:
    - languageCode: en
      key: "Shh... Just be quiet and \nmake sure no one comes."
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u0422\u0441\u0441\u0441\u2026 \u0422\u043E\u043B\u044C\u043A\u043E \u0442\u0438\u0445\u043E
        \u0438 \u0441\u043C\u043E\u0442\u0440\u0438, \n\u0447\u0442\u043E\u0431\u044B
        \u043D\u0438\u043A\u0442\u043E \u043D\u0435 \u043F\u0440\u0438\u0448\u0435\u043B."
      options:
        font: {fileID: 0}
    - languageCode: de
      key: Sei einfach leise und lass niemanden rein.
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "Chut... Ne fais pas de bruit \net ne laisse personne entrer."
      options:
        font: {fileID: 0}
    - languageCode: it
      key: Fai silenzio e non far entrare nessuno.
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "Shh... S\xF3lo qu\xE9date callado \ny no dejes que nadie entre."
      options:
        font: {fileID: 0}
