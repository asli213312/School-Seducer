    - languageCode: ru
      key: {fileID: 8300000, guid: f3819e9195bf21d4f9da70ccf6830d6e, type: 3}
    - languageCode: de
      key: {fileID: 8300000, guid: a686587e32cd21f46996afe905632d1f, type: 3}
    - languageCode: sp
      key: {fileID: 8300000, guid: 6c7293922dc9b6c468945855ccebfb8d, type: 3}
    - languageCode: it
      key: {fileID: 8300000, guid: 4b07b2ef5ab57e747bb7ff46cea475fe, type: 3}
    - languageCode: fr
      key: {fileID: 8300000, guid: 0cc309edbef2055439ce8558963d05ed, type: 3}
    _localizedData:
    - languageCode: en
      key: "Do you want me to help you with motivation? \nI know a great method."
      options:
        font: {fileID: 0}
    - languageCode: ru
      key: "\u0425\u043E\u0447\u0435\u0448\u044C \u044F \u043F\u043E\u043C\u043E\u0433\u0443
        \u0442\u0435\u0431\u0435 \u0441 \u043C\u043E\u0442\u0438\u0432\u0430\u0446\u0438\u0435\u0439?
        \n\u042F \u0437\u043D\u0430\u044E \u043E\u0442\u043B\u0438\u0447\u043D\u044B\u0439
        \u043C\u0435\u0442\u043E\u0434."
      options:
        font: {fileID: 0}
    - languageCode: de
      key: "Soll ich dir helfen, dich zu motivieren? \nIch kenne eine tolle Methode."
      options:
        font: {fileID: 0}
    - languageCode: fr
      key: "Tu veux que je t'aide \xE0 te motiver ? \nJe connais une bonne m\xE9thode."
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "Vuoi che ti aiuti a motivarti? \nConosco un ottimo metodo."
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "\xBFQuieres que te ayude a motivarte? \nConozco un m\xE9todo genial."
      options:
        font: {fileID: 0}
