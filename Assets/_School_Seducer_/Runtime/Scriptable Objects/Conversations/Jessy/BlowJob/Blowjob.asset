    - languageCode: fr
      key: "Oui, bien s\xFBr."
      options:
        font: {fileID: 0}
    - languageCode: it
      key: "S\xEC, certo."
      options:
        font: {fileID: 0}
    - languageCode: sp
      key: "S\xED, claro."
